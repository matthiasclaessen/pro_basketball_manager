.app {
    flex-grow: 1;
    flex-direction: row;
    background-color: #f3f4f6;
    color: #111827;
}

.sidebar {
    width: 240px;
    flex-shrink: 0;
    background-color: #111827;
    padding-top: 28px;
    padding-right: 20px;
    padding-bottom: 24px;
    padding-left: 20px;
}

.navigation {
    flex-grow: 1;
}

.nav-item {
    height: 44px;
    color: #9ca3af;
    background-color: rgba(0, 0, 0, 0);
    font-size: 14px;
    padding-left: 14px;
    margin-bottom: 4px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    -unity-text-align: middle-left;
}

.nav-item:hover {
    color: #ffffff;
    background-color: #1f2937;
}

.nav-item-active {
    color: #ffffff;
    background-color: #1f2937;
    border-left-width: 3px;
    border-left-color: #f97316;
}

.nav-item-disabled {
    color: #4b5563;
}

.sidebar-footer {
    border-top-width: 1px;
    border-top-color: #374151;
    padding-top: 18px;
}

.sidebar-footer-label {
    color: #6b7280;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.sidebar-footer-version {
    color: #9ca3af;
    font-size: 12px;
    margin-top: 4px;
}

.main {
    flex-grow: 1;
}

.topbar {
    height: 76px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: #ffffff;
    padding-left: 32px;
    padding-right: 32px;
    border-bottom-width: 1px;
    border-bottom-color: #e5e7eb;
}

.topbar-club-name {
    color: #111827;
    font-size: 16px;
    -unity-font-style: bold;
}

.topbar-league-name {
    color: #6b7280;
    font-size: 12px;
    margin-top: 3px;
}

.topbar-season {
    align-items: flex-end;
}

.season-value {
    color: #111827;
    font-size: 14px;
    -unity-font-style: bold;
}

.season-label {
    color: #9ca3af;
    font-size: 10px;
    margin-top: 2px;
    letter-spacing: 1px;
}

.content {
    flex-grow: 1;
    padding-top: 30px;
    padding-right: 32px;
    padding-bottom: 32px;
    padding-left: 32px;
}

.team-switcher {
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(226, 232, 240);
}

.team-switcher-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.team-switcher-item {
    flex-grow: 1;
    font-size: 12px;
    padding: 6px 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(100, 116, 139);
    -unity-text-align: middle-left;
}

.team-switcher-item:hover {
    color: rgb(15, 23, 42);
}

.team-switcher-item-active {
    color: rgb(15, 23, 42);
    -unity-font-style: bold;
}

.team-switcher-toggle {
    width: 40px;
    font-size: 10px;
    padding: 4px 0;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
    background-color: rgb(248, 250, 252);
    color: rgb(148, 163, 184);
}

.team-switcher-toggle-on {
    background-color: rgb(220, 252, 231);
    border-color: rgb(134, 239, 172);
    color: rgb(22, 101, 52);
}

.topbar-badge {
    margin-right: 10px;
}
