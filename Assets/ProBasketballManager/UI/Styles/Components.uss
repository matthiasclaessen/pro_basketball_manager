.card {
    background-color: #ffffff;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #e5e7eb;
    border-right-color: #e5e7eb;
    border-bottom-color: #e5e7eb;
    border-left-color: #e5e7eb;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.card-eyebrow {
    color: #9ca3af;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 5px;
}

.card-title {
    color: #111827;
    font-size: 17px;
    -unity-font-style: bold;
}

.status-badge {
    color: #c2410c;
    background-color: #fff7ed;
    font-size: 10px;
    -unity-font-style: bold;
    padding-top: 5px;
    padding-right: 9px;
    padding-bottom: 5px;
    padding-left: 9px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #fed7aa;
    border-right-color: #fed7aa;
    border-bottom-color: #fed7aa;
    border-left-color: #fed7aa;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}

.team-block {
    width: 34%;
    align-items: center;
}

.team-name {
    color: #111827;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.team-side-label {
    color: #9ca3af;
    font-size: 10px;
    -unity-font-style: bold;
    margin-top: 8px;
    letter-spacing: 1px;
}

.score-block {
    width: 32%;
    align-items: center;
}

.score-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.score {
    width: 74px;
    color: #111827;
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.score-separator {
    color: #d1d5db;
    font-size: 30px;
    margin-left: 7px;
    margin-right: 7px;
}

.bottom-grid {
    flex-direction: row;
    margin-top: 24px;
}

.metric-row {
    height: 47px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: #f3f4f6;
}

.metric-label {
    color: #6b7280;
    font-size: 12px;
}

.metric-value {
    color: #111827;
    font-size: 14px;
    -unity-font-style: bold;
}

.star-rating {
    flex-direction: row;
    align-items: center;
}

.star-rating-item {
    flex-shrink: 0;
    margin-right: 1px;
    background-size: 100% 100%;
}

.role-badge-profile {
    width: 90px;
    margin-left: 16px;
}

.club-badge {
    display: flex;
    align-items: center;
    justify-content: center;
}

.club-badge-initials {
    font-size: 10px;
}

.player-flag {
    flex-shrink: 0;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgb(226, 232, 240);
    background-size: 100% 100%;
}

.player-flag-missing {
    background-color: rgb(226, 232, 240);
}
