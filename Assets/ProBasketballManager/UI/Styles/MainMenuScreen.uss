.welcome-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.welcome-screen {
    flex-grow: 1;
    position: relative;
    align-items: center;
    justify-content: center;
    background-color: #f8fafc;
    color: #111827;
    overflow: hidden;
}

.background-glow {
    position: absolute;
    width: 760px;
    height: 760px;
    border-top-left-radius: 380px;
    border-top-right-radius: 380px;
    border-bottom-left-radius: 380px;
    border-bottom-right-radius: 380px;
    background-color: rgba(249, 115, 22, 0.025);
}

.background-glow-left {
    left: -420px;
    bottom: -330px;
}

.background-glow-right {
    right: -380px;
    top: -360px;
}

.basketball-watermark {
    position: absolute;
    width: 620px;
    height: 620px;
    right: -150px;
    top: -110px;
    border-top-width: 18px;
    border-right-width: 18px;
    border-bottom-width: 18px;
    border-left-width: 18px;
    border-top-color: rgba(17, 24, 39, 0.025);
    border-right-color: rgba(17, 24, 39, 0.025);
    border-bottom-color: rgba(17, 24, 39, 0.025);
    border-left-color: rgba(17, 24, 39, 0.025);
    border-top-left-radius: 310px;
    border-top-right-radius: 310px;
    border-bottom-left-radius: 310px;
    border-bottom-right-radius: 310px;
}

.basketball-line {
    position: absolute;
    background-color: rgba(17, 24, 39, 0.025);
}

.basketball-line-horizontal {
    left: 0;
    right: 0;
    top: 292px;
    height: 18px;
}

.basketball-line-vertical {
    top: 0;
    bottom: 0;
    left: 292px;
    width: 18px;
}

.basketball-curve {
    position: absolute;
    width: 350px;
    height: 580px;
    top: 0;
    border-top-width: 18px;
    border-right-width: 18px;
    border-bottom-width: 18px;
    border-left-width: 18px;
    border-top-color: rgba(17, 24, 39, 0.025);
    border-right-color: rgba(17, 24, 39, 0.025);
    border-bottom-color: rgba(17, 24, 39, 0.025);
    border-left-color: rgba(17, 24, 39, 0.025);
    border-top-left-radius: 175px;
    border-top-right-radius: 175px;
    border-bottom-left-radius: 175px;
    border-bottom-right-radius: 175px;
}

.basketball-curve-left {
    left: -175px;
}

.basketball-curve-right {
    right: -175px;
}

.welcome-content {
    width: 620px;
    align-items: center;
}

.welcome-brand {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.brand-mark {
    width: 112px;
    height: 112px;
    align-items: center;
    justify-content: center;
    margin-right: 26px;
    background-color: #ffffff;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #e5e7eb;
    border-right-color: #e5e7eb;
    border-bottom-color: #e5e7eb;
    border-left-color: #e5e7eb;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
}

.brand-ball {
    width: 72px;
    height: 72px;
    align-items: center;
    justify-content: center;
    background-color: #fff7ed;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-color: #f97316;
    border-right-color: #f97316;
    border-bottom-color: #f97316;
    border-left-color: #f97316;
    border-top-left-radius: 36px;
    border-top-right-radius: 36px;
    border-bottom-left-radius: 36px;
    border-bottom-right-radius: 36px;
}

.brand-ball-label {
    color: #f97316;
    font-size: 20px;
    -unity-font-style: bold;
}

.brand-text {
    justify-content: center;
}

.brand-divider {
    width: 82px;
    height: 3px;
    margin-top: 28px;
    margin-bottom: 24px;
    background-color: #f97316;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.welcome-tagline {
    color: #64748b;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    margin-bottom: 38px;
}

.welcome-status {
    margin-top: 14px;
    color: #b91c1c;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.menu {
    width: 100%;
}

.menu-button {
    width: 100%;
    height: 108px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    padding-top: 16px;
    padding-right: 22px;
    padding-bottom: 16px;
    padding-left: 22px;
    background-color: #ffffff;
    color: #111827;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #e5e7eb;
    border-right-color: #e5e7eb;
    border-bottom-color: #e5e7eb;
    border-left-color: #e5e7eb;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    -unity-text-align: middle-left;
}

.menu-button:hover {
    background-color: #fffaf5;
    border-top-color: #fdba74;
    border-right-color: #fdba74;
    border-bottom-color: #fdba74;
    border-left-color: #fdba74;
}

.menu-button:active {
    background-color: #fff7ed;
    border-top-color: #f97316;
    border-right-color: #f97316;
    border-bottom-color: #f97316;
    border-left-color: #f97316;
}

.menu-button:focus {
    border-top-color: #f97316;
    border-right-color: #f97316;
    border-bottom-color: #f97316;
    border-left-color: #f97316;
}

.menu-button-icon {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
    background-color: #fff7ed;
    border-top-left-radius: 31px;
    border-top-right-radius: 31px;
    border-bottom-left-radius: 31px;
    border-bottom-right-radius: 31px;
}

.menu-button-icon-label {
    color: #f97316;
    font-size: 14px;
    -unity-font-style: bold;
}

.menu-button-content {
    flex-grow: 1;
    justify-content: center;
}

.menu-button-title {
    color: #111827;
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.menu-button-description {
    color: #64748b;
    font-size: 13px;
    margin-top: 6px;
}

.menu-button-arrow {
    width: 36px;
    color: #f97316;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.menu-button > .unity-button__text {
    display: none;
}

.version-info {
    position: absolute;
    left: 42px;
    bottom: 34px;
}

.version-label {
    color: #f97316;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.version-value {
    color: #94a3b8;
    font-size: 11px;
    margin-top: 4px;
}

.copyright {
    position: absolute;
    right: 42px;
    bottom: 38px;
    color: #94a3b8;
    font-size: 11px;
}
