.welcome-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.welcome-screen {
    flex-grow: 1;
    position: relative;
    align-items: center;
    justify-content: center;
    background-color: #f8fafc;
    background-image: url("../Images/Background.png");
    background-size: cover;
    background-position: center;
    color: #111827;
    overflow: hidden;
}

.welcome-screen .brand-title {
    color: #111827;
}

.welcome-content {
    width: 620px;
    align-items: center;
}

.welcome-brand {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.brand-text {
    justify-content: center;
}

.brand-text .brand-kicker {
    font-size: 40px;
    margin-bottom: -12px;
    color: #f97316;
}

.brand-text .brand-title {
    font-size: 40px;
}

.brand-text .brand-title {
    margin-bottom: -12px;
}

.brand-divider {
    width: 82px;
    height: 2px;
    margin-top: 28px;
    margin-bottom: 24px;
    background-color: #f97316;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.welcome-tagline {
    color: #64748b;
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
    -unity-text-align: middle-center;
    margin-bottom: 38px;
}

.welcome-status {
    margin-top: 14px;
    color: #b91c1c;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.menu {
    width: 100%;
}

.menu-button {
    width: 100%;
    height: 108px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
    padding-top: 16px;
    padding-right: 22px;
    padding-bottom: 16px;
    padding-left: 22px;
    background-color: #ffffff;
    color: #111827;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(18, 37, 71, 0.14);
    border-right-color: rgba(18, 37, 71, 0.14);
    border-bottom-color: rgba(18, 37, 71, 0.14);
    border-left-color: rgba(18, 37, 71, 0.14);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    -unity-text-align: middle-left;
}

.menu-button:hover {
    background-color: #fffaf5;
    border-top-color: #fdba74;
    border-right-color: #fdba74;
    border-bottom-color: #fdba74;
    border-left-color: #fdba74;
}

.menu-button:active {
    background-color: #fff7ed;
    border-top-color: #f97316;
    border-right-color: #f97316;
    border-bottom-color: #f97316;
    border-left-color: #f97316;
}

.menu-button:focus {
    border-top-color: #f97316;
    border-right-color: #f97316;
    border-bottom-color: #f97316;
    border-left-color: #f97316;
}

.menu-button-icon {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
    background-color: #fff7ed;
    background-size: 26px 26px;
    background-position: center;
    border-top-left-radius: 31px;
    border-top-right-radius: 31px;
    border-bottom-left-radius: 31px;
    border-bottom-right-radius: 31px;
}

.menu-button-icon-new-game {
    background-image: url("../Icons/basketball.svg");
}

.menu-button-icon-load-game {
    background-image: url("../Icons/folder-open.svg");
}

.menu-button-icon-exit-game {
    background-image: url("../Icons/log-out.svg");
}

.menu-button-content {
    flex-grow: 1;
    justify-content: center;
}

.menu-button-title {
    color: #111827;
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin: 0;
}

.menu-button-description {
    color: #64748b;
    font-size: 13px;
    margin: 0;
}

.menu-button-arrow {
    width: 36px;
    color: #f97316;
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.menu-button > .unity-button__text {
    display: none;
}

.version-info {
    position: absolute;
    left: 42px;
    bottom: 34px;
}

.version-label {
    color: #f97316;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.version-value {
    color: #94a3b8;
    font-size: 11px;
    margin-top: 4px;
}

.copyright {
    position: absolute;
    right: 42px;
    bottom: 38px;
    color: #94a3b8;
    font-size: 11px;
}

.version-label {
    color: #FE8512;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.version-value {
    color: #C7D0DE;
    font-size: 11px;
    margin-top: 4px;
}

.copyright {
    position: absolute;
    right: 42px;
    bottom: 38px;
    color: #C7D0DE;
    font-size: 11px;
}
