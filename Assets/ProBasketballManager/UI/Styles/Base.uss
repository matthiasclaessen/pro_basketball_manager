:root {
    -unity-font-definition: url("project://database/Assets/ProBasketballManager/Resources/Fonts%20&%20Materials/Inter_18pt-Regular%20SDF.asset");
    --pbm-navy: #122547;
    --pbm-navy-deep: #0E2040;
    --pbm-navy-hover: #1B3260;
    --pbm-navy-tint: #EDF1F7;
    --pbm-orange: #F78222;
    --pbm-orange-bright: #FE8512;
    --pbm-orange-hover: #E06E12;
    --pbm-orange-tint: #FFF4E8;
    --pbm-orange-border: #FBC28A;
    --pbm-surface: #FFFFFF;
    --pbm-border: #E2E8F0;
    --pbm-text: #0F172A;
    --pbm-text-muted: #64748B;
}

.font-extrabold {
    -unity-font-definition: url("project://database/Assets/ProBasketballManager/Resources/Fonts%20&%20Materials/Inter_18pt-ExtraBold SDF.asset");
    -unity-font-style: normal;
}

.font-black {
    -unity-font-definition: url("project://database/Assets/ProBasketballManager/Resources/Fonts%20&%20Materials/Inter_18pt-Black SDF.asset");
    -unity-font-style: normal;
}

.page-title {
    font-size: 28px;
    color: #111827;
}

.page-subtitle {
    font-size: 14px;
    color: #6b7280;
    margin-top: 5px;
}

.primary-button {
    width: 220px;
    height: 46px;
    align-self: center;
    color: #ffffff;
    background-color: #f97316;
    font-size: 13px;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
}

.primary-button:hover {
    background-color: #ea580c;
}

.primary-button:active {
    background-color: #c2410c;
}

.panel-title {
    color: #111827;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.screen {
    flex-grow: 1;
}

.screen > TemplateContainer {
    flex-grow: 1;
}

.screen-hidden {
    display: none;
}

.secondary-button {
    height: 38px;
    color: #374151;
    background-color: #ffffff;
    font-size: 12px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #d1d5db;
    border-right-color: #d1d5db;
    border-bottom-color: #d1d5db;
    border-left-color: #d1d5db;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 14px;
    padding-right: 14px;
}

.secondary-button:hover {
    background-color: #f9fafb;
}

.instant-result-button {
    height: 34px;
    color: #c2410c;
    background-color: #fff7ed;
    font-size: 11px;
    -unity-font-style: bold;
    padding-left: 14px;
    padding-right: 14px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #fed7aa;
    border-right-color: #fed7aa;
    border-bottom-color: #fed7aa;
    border-left-color: #fed7aa;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}

.section-label {
    color: #9ca3af;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 12px;
}
