.load-game-screen {
    flex-grow: 1;
    position: relative;
    background-color: #f8fafc;
    color: #111827;
    overflow: hidden;
}

.background-decoration {
    position: absolute;
    width: 700px;
    height: 700px;
    border-top-left-radius: 350px;
    border-top-right-radius: 350px;
    border-bottom-left-radius: 350px;
    border-bottom-right-radius: 350px;
    border-top-width: 18px;
    border-right-width: 18px;
    border-bottom-width: 18px;
    border-left-width: 18px;
    border-top-color: rgba(15, 23, 42, 0.018);
    border-right-color: rgba(15, 23, 42, 0.018);
    border-bottom-color: rgba(15, 23, 42, 0.018);
    border-left-color: rgba(15, 23, 42, 0.018);
}

.background-decoration-left {
    left: -500px;
    bottom: -400px;
}

.background-decoration-right {
    right: -260px;
    top: -340px;
}

.top-bar {
    height: 92px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 30px;
    padding-right: 30px;
    padding-top: 18px;
}

.load-game-brand {
    flex-direction: row;
    align-items: center;
}

.brand-logo {
    width: 54px;
    height: 54px;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    background-color: #ffffff;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #111827;
    border-right-color: #111827;
    border-bottom-color: #111827;
    border-left-color: #111827;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.brand-logo-text {
    color: #f97316;
    font-size: 13px;
    -unity-font-style: bold;
}

.brand-title-container {
    justify-content: center;
}

.brand-title-row {
    flex-direction: row;
}

.load-game-screen .brand-title {
    color: #111827;
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.brand-title-accent {
    color: #f97316;
    font-size: 21px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.back-button {
    height: 44px;
    padding-left: 20px;
    padding-right: 20px;
    background-color: #ffffff;
    color: #111827;
    font-size: 13px;
    -unity-font-style: bold;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #e2e8f0;
    border-right-color: #e2e8f0;
    border-bottom-color: #e2e8f0;
    border-left-color: #e2e8f0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.back-button:hover {
    background-color: #f8fafc;
    border-top-color: #cbd5e1;
    border-right-color: #cbd5e1;
    border-bottom-color: #cbd5e1;
    border-left-color: #cbd5e1;
}

.page-heading {
    height: 120px;
    align-items: center;
    justify-content: center;
}

.page-title {
    color: #111827;
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.page-subtitle {
    margin-top: 8px;
    color: #64748b;
    font-size: 15px;
}

.title-divider {
    width: 56px;
    height: 3px;
    margin-top: 16px;
    background-color: #f97316;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.load-game-status {
    margin-left: 7%;
    margin-right: 7%;
    margin-bottom: 10px;
    color: #b91c1c;
    font-size: 12px;
    white-space: normal;
}

.load-layout {
    flex-grow: 1;
    flex-direction: row;
    padding-left: 7%;
    padding-right: 7%;
    padding-bottom: 50px;
}

.save-browser {
    flex-grow: 1;
    margin-right: 24px;
}

.selected-column {
    width: 420px;
}

.save-scroll {
    flex-grow: 1;
}

.save-list {
    flex-grow: 1;
}

.save-list-empty {
    padding-top: 40px;
    color: #64748b;
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.save-row {
    height: 78px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding-left: 20px;
    padding-right: 18px;
    background-color: #ffffff;
    color: #111827;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #e5e7eb;
    border-right-color: #e5e7eb;
    border-bottom-color: #e5e7eb;
    border-left-color: #e5e7eb;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    -unity-text-align: middle-left;
}

.save-row:hover {
    background-color: #fffaf5;
    border-top-color: #fdba74;
    border-right-color: #fdba74;
    border-bottom-color: #fdba74;
    border-left-color: #fdba74;
}

.save-row-selected {
    background-color: #fffaf5;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: #f97316;
    border-right-color: #f97316;
    border-bottom-color: #f97316;
    border-left-color: #f97316;
}

.save-row-unreadable {
    background-color: #fef2f2;
    border-top-color: #fecaca;
    border-right-color: #fecaca;
    border-bottom-color: #fecaca;
    border-left-color: #fecaca;
}

.save-row-unreadable:hover {
    background-color: #fef2f2;
    border-top-color: #fca5a5;
    border-right-color: #fca5a5;
    border-bottom-color: #fca5a5;
    border-left-color: #fca5a5;
}

.save-logo {
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.save-logo-placeholder {
    color: #475569;
    font-size: 10px;
    -unity-font-style: bold;
}

.save-field {
    justify-content: center;
}

.save-field-name {
    width: 180px;
}

.save-field-last-played {
    width: 220px;
}

.save-field-season {
    flex-grow: 1;
}

.save-field-label {
    color: #64748b;
    font-size: 10px;
    margin-bottom: 4px;
}

.save-field-value {
    color: #111827;
    font-size: 13px;
    -unity-font-style: bold;
}

.save-field-value-error {
    color: #b91c1c;
}

.save-separator {
    width: 1px;
    height: 38px;
    margin-left: 18px;
    margin-right: 26px;
    background-color: #e2e8f0;
}

.selected-check {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-left: 14px;
    background-color: #f97316;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.selected-check-label {
    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
}

.selected-check-hidden {
    visibility: hidden;
}

.save-row > .unity-button__text {
    display: none;
}

.selected-save-card {
    flex-grow: 1;
    min-height: 490px;
    padding-top: 28px;
    padding-right: 28px;
    padding-bottom: 28px;
    padding-left: 28px;
    background-color: #ffffff;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #e2e8f0;
    border-right-color: #e2e8f0;
    border-bottom-color: #e2e8f0;
    border-left-color: #e2e8f0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

.selected-save-badge {
    align-self: center;
    padding-top: 5px;
    padding-right: 11px;
    padding-bottom: 5px;
    padding-left: 11px;
    color: #f97316;
    background-color: #fff7ed;
    font-size: 10px;
    -unity-font-style: bold;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #fdba74;
    border-right-color: #fdba74;
    border-bottom-color: #fdba74;
    border-left-color: #fdba74;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.selected-save-logo {
    width: 54px;
    height: 54px;
    align-self: center;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    margin-bottom: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.selected-save-logo-placeholder {
    color: #475569;
    font-size: 11px;
    -unity-font-style: bold;
}

.selected-save-divider,
.detail-divider {
    height: 1px;
    background-color: #e2e8f0;
}

.selected-info-row {
    height: 92px;
    flex-direction: row;
    align-items: center;
}

.detail-icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    background-color: #f8fafc;
    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}

.detail-icon-text {
    color: #475569;
    font-size: 11px;
    -unity-font-style: bold;
}

.detail-content {
    justify-content: center;
}

.detail-label {
    color: #64748b;
    font-size: 11px;
    margin-bottom: 5px;
}

.detail-value {
    color: #111827;
    font-size: 14px;
    -unity-font-style: bold;
}

.selected-actions {
    height: 78px;
    flex-direction: row;
    padding-top: 16px;
}

.delete-button {
    flex-grow: 1;
    height: 52px;
    margin-right: 12px;
    background-color: #ffffff;
    color: #111827;
    font-size: 13px;
    -unity-font-style: bold;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: #e2e8f0;
    border-right-color: #e2e8f0;
    border-bottom-color: #e2e8f0;
    border-left-color: #e2e8f0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.delete-button:hover {
    color: #dc2626;
    background-color: #fef2f2;
    border-top-color: #fecaca;
    border-right-color: #fecaca;
    border-bottom-color: #fecaca;
    border-left-color: #fecaca;
}

.load-button {
    width: 205px;
    height: 52px;
    background-color: #f97316;
    color: #ffffff;
    font-size: 14px;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.load-button:hover {
    background-color: #ea580c;
}

.load-button:active {
    background-color: #c2410c;
}

.load-button:disabled,
.delete-button:disabled {
    opacity: 0.45;
}
