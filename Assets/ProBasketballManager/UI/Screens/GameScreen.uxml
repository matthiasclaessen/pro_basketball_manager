<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Assets/ProBasketballManager/UI/Styles/Base.uss" />
    <Style src="project://database/Assets/ProBasketballManager/UI/Styles/Shell.uss" />
    <Style src="project://database/Assets/ProBasketballManager/UI/Styles/Components.uss" />
    <Style src="project://database/Assets/ProBasketballManager/UI/Styles/MainMenuScreen.uss" />
    <Style src="project://database/Assets/ProBasketballManager/UI/Styles/LoadGameScreen.uss" />
    <!-- <Style src="project://database/Assets/ProBasketballManager/UI/Styles/Screens/Squad.uss" /> -->
    <ui:Template name="DashboardScreen" src="project://database/Assets/ProBasketballManager/UI/Screens/DashboardScreen.uxml" />
    <ui:Template name="WelcomeScreen" src="project://database/Assets/ProBasketballManager/UI/Screens/MainMenuScreen.uxml" />
    <ui:Template name="LoadGameScreen" src="project://database/Assets/ProBasketballManager/UI/Screens/LoadGameScreen.uxml" />
    <ui:Template name="SquadScreen" src="project://database/Assets/ProBasketballManager/UI/Screens/SquadScreen.uxml" />
    <ui:VisualElement name="root" class="app">
        <ui:VisualElement class="sidebar">
            <ui:VisualElement class="brand">
                <ui:Label text="PRO" class="brand-kicker" />
                <ui:Label text="BASKETBALL" class="brand-title" />
                <ui:Label text="MANAGER" class="brand-title" />
            </ui:VisualElement>
            <ui:VisualElement name="navigation-bar" class="navigation">
                <ui:Button name="nav-dashboard-button" text="Dashboard" class="nav-item nav-item-active" />
                <ui:Button name="nav-squad-button" text="Squad" class="nav-item" />
                <ui:Button name="nav-tactics-button" text="Tactics" class="nav-item" />
                <ui:Button name="nav-schedule-button" text="Schedule" class="nav-item" />
                <ui:Button name="nav-league-button" text="League" class="nav-item" />
                <ui:Button name="nav-save-load-button" text="Save / Load" class="nav-item" />
            </ui:VisualElement>
            <ui:VisualElement class="sidebar-footer">
                <ui:Label text="PROTOTYPE" class="sidebar-footer-label" />
                <ui:Label text="Version 0.1" class="sidebar-footer-version" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="main">
            <ui:VisualElement class="topbar">
                <ui:VisualElement name="topbar-badge" class="topbar-badge" />
                <ui:VisualElement>
                    <ui:Label name="club-name" text="Club" class="topbar-club-name" />
                    <ui:Label name="league-name" text="League" class="topbar-league-name" />
                </ui:VisualElement>
                <ui:VisualElement class="topbar-season">
                    <ui:Label name="season-name" text="2026 / 27" class="season-value" />
                    <ui:Label name="current-date" text="" class="season-label" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="content">
                <ui:VisualElement name="dashboard-screen" class="screen screen-hidden">
                    <ui:Instance template="DashboardScreen" />
                </ui:VisualElement>
                <ui:VisualElement name="squad-screen" class="screen screen-hidden">
                    <ui:Instance template="SquadScreen" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="main-menu-screen" class="screen welcome-host">
            <ui:Instance template="WelcomeScreen" />
        </ui:VisualElement>
        <ui:VisualElement name="load-game-screen" class="screen screen-hidden welcome-host">
            <ui:Instance template="LoadGameScreen" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
